{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "packages:stylelint"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Cloudflare build/deploy toolchain",
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge pure dev tooling (linting, testing) for minor/patch",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "globals",
        "stylelint",
        "stylelint-config-standard",
        "karma",
        "karma-chrome-launcher",
        "karma-coverage",
        "karma-jasmine",
        "karma-jasmine-html-reporter",
        "jasmine-core",
        "knip",
        "typescript-eslint",
        "vitest"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
