{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "packages:stylelint"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customDatasources": {
    "cloudflare-compatibility-date": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/cloudflare/workerd/releases?per_page=20",
      "transformTemplates": [
        "{ \"releases\": [$map($, function($v) { $contains($v.tag_name, /^v\\d+\\.\\d{8}\\.\\d+$/) ? { \"version\": $substring($v.tag_name, 3, 4) & \"-\" & $substring($v.tag_name, 7, 2) & \"-\" & $substring($v.tag_name, 9, 2), \"changelogUrl\": \"https://github.com/cloudflare/workerd/releases/tag/\" & $v.tag_name } }) [version]], \"sourceUrl\": \"https://github.com/cloudflare/workerd\" }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Cloudflare Workers compatibility_date in wrangler config",
      "managerFilePatterns": ["**/wrangler.{json,jsonc,toml}"],
      "matchStrings": [
        "\"?compatibility_date\"?\\s*[:=]\\s*\"(?<currentValue>\\d{4}-\\d{2}-\\d{2})\""
      ],
      "depNameTemplate": "cloudflare/workerd",
      "datasourceTemplate": "custom.cloudflare-compatibility-date",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Update Cloudflare Workers compatibility_date monthly (never automerge)",
      "matchDepNames": ["cloudflare/workerd"],
      "automerge": false,
      "schedule": ["on the first day of the month"]
    },
    {
      "description": "Group Cloudflare build/deploy toolchain",
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge pure dev tooling (linting, testing) for minor/patch",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "globals",
        "stylelint",
        "stylelint-config-standard",
        "karma",
        "karma-chrome-launcher",
        "karma-coverage",
        "karma-jasmine",
        "karma-jasmine-html-reporter",
        "jasmine-core",
        "html-validate",
        "knip",
        "typescript-eslint",
        "vitest",
        "renovate"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
